#!/usr/bin/env python3
"""Regenerate site/ from the canonical S2UI files.

site/ is the static site served at https://yakov.khalinsky.com/s2ui/.
site/index.html is hand-written and kept; everything under
site/schema/, site/examples/ and site/spec/ is copied from the
canonical files, and site/spec.html is rendered from spec/S2UI-1.md
by the small Markdown converter below (headings, paragraphs, lists,
tables, fenced code, inline code/bold/italic/links — the subset the
spec uses). Run after editing any canonical file:

    python3 tools/build-site
"""
import html
import json
import re
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SITE = ROOT / "site"
BASE = "https://yakov.khalinsky.com/s2ui/"

CSS = """
:root { color-scheme: dark; }
* { box-sizing: border-box; }
body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
       background: #0f172a; color: #e2e8f0; line-height: 1.65; }
main { max-width: 880px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
a { color: #7dd3fc; }
h1 { font-size: 2.1rem; line-height: 1.15; }
h2 { font-size: 1.45rem; margin-top: 2.4rem; color: #f1f5f9; }
h3 { font-size: 1.15rem; margin-top: 1.8rem; }
code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .92em;
       background: #1e293b; padding: .1em .35em; border-radius: 4px; }
pre { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 1rem; overflow-x: auto; }
pre code { background: none; padding: 0; }
table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .94rem; }
th, td { border: 1px solid #334155; padding: .5rem .7rem; text-align: left; vertical-align: top; }
th { background: #1e293b; }
hr { border: none; border-top: 1px solid #334155; margin: 2rem 0; }
.crumb { font-size: .9rem; color: #94a3b8; }
"""


def inline(text: str) -> str:
    text = html.escape(text)
    text = re.sub(r"`([^`]+)`", r"<code>\1</code>", text)
    text = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", text)
    text = re.sub(r"(?<![\w*])\*([^*\n]+)\*(?![\w*])", r"<em>\1</em>", text)
    text = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', text)
    return text


def slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def md_to_html(md: str) -> str:
    lines = md.split("\n")
    out, i, n = [], 0, len(lines)
    para, lst = [], None  # lst: [tag, [items]]

    def flush_para():
        if para:
            out.append("<p>" + inline(" ".join(para)) + "</p>")
            para.clear()

    def flush_list():
        nonlocal lst
        if lst:
            tag, items = lst
            out.append(f"<{tag}>" + "".join(f"<li>{inline(it)}</li>" for it in items) + f"</{tag}>")
            lst = None

    while i < n:
        line = lines[i]
        if line.startswith("```"):
            flush_para(); flush_list()
            buf = []
            i += 1
            while i < n and not lines[i].startswith("```"):
                buf.append(lines[i]); i += 1
            i += 1
            out.append("<pre><code>" + html.escape("\n".join(buf)) + "</code></pre>")
            continue
        if line.strip() == "":
            flush_para(); flush_list(); i += 1; continue
        m = re.match(r"^(#{1,6})\s+(.*)$", line)
        if m:
            flush_para(); flush_list()
            level, text = len(m.group(1)), m.group(2)
            out.append(f'<h{level} id="{slug(text)}">{inline(text)}</h{level}>')
            i += 1; continue
        if re.match(r"^---+$", line.strip()):
            flush_para(); flush_list(); out.append("<hr>"); i += 1; continue
        if line.lstrip().startswith("|") and i + 1 < n and re.match(r"^\s*\|[\s:|-]+\|\s*$", lines[i + 1]):
            flush_para(); flush_list()
            head = [c.strip() for c in line.strip().strip("|").split("|")]
            i += 2
            rows = []
            while i < n and lines[i].lstrip().startswith("|"):
                rows.append([c.strip() for c in lines[i].strip().strip("|").split("|")])
                i += 1
            thead = "".join(f"<th>{inline(c)}</th>" for c in head)
            body = "".join("<tr>" + "".join(f"<td>{inline(c)}</td>" for c in r) + "</tr>" for r in rows)
            out.append(f"<table><thead><tr>{thead}</tr></thead><tbody>{body}</tbody></table>")
            continue
        m = re.match(r"^(\s*)[-*]\s+(.*)$", line)
        tag = "ul"
        if not m:
            m = re.match(r"^(\s*)\d+\.\s+(.*)$", line)
            tag = "ol"
        if m:
            flush_para()
            if lst is None or lst[0] != tag:
                flush_list(); lst = [tag, []]
            lst[1].append(m.group(2))
            i += 1; continue
        if lst and (line.startswith("  ") or line.startswith("\t")):
            lst[1][-1] += " " + line.strip()
            i += 1; continue
        flush_list()
        para.append(line.strip())
        i += 1
    flush_para(); flush_list()
    return "\n".join(out)


def main() -> int:
    for sub in ("schema", "examples", "spec"):
        dst = SITE / sub
        if dst.exists():
            shutil.rmtree(dst)
        shutil.copytree(ROOT / sub, dst)
    # Verify every published schema carries its stable public $id.
    for f in sorted((SITE / "schema").glob("*.json")):
        data = json.loads(f.read_text())
        expected = f"{BASE}schema/{f.name}"
        if data.get("$id") != expected:
            print(f"FAIL {f.name}: $id is {data.get('$id')!r}, expected {expected!r}")
            return 1
    spec_md = (ROOT / "spec" / "S2UI-1.md").read_text()
    body = md_to_html(spec_md)
    page = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="S2UI/1 — Supervisor-to-UI specification. A profile of A2UI 1.0 for supervisor run state.">
<meta name="theme-color" content="#0f172a">
<title>S2UI/1 — Supervisor-to-UI specification</title>
<style>{CSS}</style>
</head>
<body>
<main>
<p class="crumb"><a href="./">S2UI home</a> · <a href="spec/S2UI-1.md">Raw Markdown</a> ·
<a href="https://github.com/yakovkhalinsky/s2ui">GitHub</a></p>
{body}
</main>
</body>
</html>
"""
    (SITE / "spec.html").write_text(page)
    print(f"site/ regenerated: {sum(1 for _ in SITE.rglob('*') if _.is_file())} files; all schema $ids OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
